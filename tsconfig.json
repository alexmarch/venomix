{
  "compilerOptions": {
    "esModuleInterop": true,
    "noEmit": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "*": [
        "node_modules/*",
        "core/*"
      ]
    },
  }
}
